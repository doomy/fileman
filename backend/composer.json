{
    "name": "fileman/backend",
    "description": "FileMan REST API backend (PHP 8.4 + Restopus/Nette)",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/doomy/restopus",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.4",
        "doomy/restopus": "^8.1",
        "nette/application": "^3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "Low-severity firebase/php-jwt advisory pinned transitively by doomy/security ^8 (^6.10 constraint); no fixed version satisfies that range yet."
            }
        }
    }
}
